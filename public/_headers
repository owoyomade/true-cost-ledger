# Cloudflare Pages response headers. Vite copies this file into dist/ unchanged.

# The service worker and its manifest must always be checked for updates,
# otherwise buyers can get stuck on an old version of the app.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Built files have a content hash in their name, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
